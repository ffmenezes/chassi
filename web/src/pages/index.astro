---
/**
 * A página inicial. Nasce EM BRANCO, com roteiro — ao contrário das quatro
 * jurídicas (Task 11), que nascem escritas: esta é identidade, e identidade
 * copiada de outro site é o padrão que o revisor humano do AdSense reconhece
 * na hora. Ver o comentário de `sobre.astro` para o porquê disso pesar mais
 * ainda naquela página.
 *
 * O roteiro mora em comentário HTML — sempre no código-fonte, para quem olhar
 * "ver código-fonte" encontrar — e também como texto visível, mas só em
 * `npm run dev` (`import.meta.env.DEV`): no build de produção este bloco
 * não existe no HTML, então não tem como o esqueleto ir ao ar sem que
 * alguém tenha escrito o texto de verdade por cima dele.
 */
import Artigo from "../layouts/Artigo.astro";
import { siteInstitucional } from "../institucional/dados";
import GradeArtigos from "../components/blocos/GradeArtigos.astro";
import type { Artigo as ItemDeGrade } from "../components/blocos/GradeArtigos.astro";
import { ARTIGOS } from "../mock/artigos";
import { dataBR } from "../data";
import { ESTILOS } from "../sites";

const site = siteInstitucional();

/* As quatro vitrines que sobram depois de tirar a do próprio site — só para
   quem quer comparar antes de escolher. `nomesDeEstilo()` (varredura) daria
   a mesma lista, mas aqui já se precisa do objeto ESTILOS inteiro para pegar
   o nome de exibição de cada uma, então ordenar as chaves dele resolve os
   dois sem duas fontes de verdade. */
const outrosEstilos = Object.keys(ESTILOS)
  .filter((e) => e !== site.estilo)
  .sort();

/**
 * Os três artigos de exemplo, na forma que o GradeArtigos (catálogo N2) espera.
 * Isto é conteúdo real, não roteiro: ao contrário da entrevista acima, esta
 * grade continua no build de produção, porque é ela que prova — para quem
 * clonou o chassi — como uma home de blog fica depois de escrita. Quando os
 * três artigos de exemplo saírem, é esta lista que passa a vir da coleção de
 * posts de verdade.
 */
const artigosParaGrade: ItemDeGrade[] = ARTIGOS.map((a) => ({
  tituloFeed: a.titulo,
  descricao: a.descricao,
  atualizadoEm: dataBR(a.atualizado),
  href: `/${a.slug}/`,
}));
---

<!--
  ESCREVA AQUI — a página inicial responde a estas perguntas:
  1. Que pergunta este site responde?
  2. Para quem? (quem é o leitor que chega aqui)
  3. O que ele encontra aqui que não encontra no primeiro resultado do Google?
  4. Três links para as peças principais do site.

  Antes de escrever: abra /bancada/ (os 30 blocos, com a regra de cada um) e
  /exemplo/<estilo>/ nos cinco estilos (ceu, circuito, concreto, linho, vidro)
  para saber o que o chassi já oferece.
-->
<Artigo site={site} titulo={site.nome} descricao={`O que ${site.nome} responde, e para quem.`}>
  <div class="pagina-inicial">
    <header class="hero">
      <p class="selo">{site.nome}</p>
      <h1 class="b-h1">Escreva aqui o que este site resolve, numa frase.</h1>
      <p class="b-p">
        Escreva aqui, num parágrafo curto, para quem é este site e o que ele promete
        que o leitor não vai achar pronto no primeiro resultado do Google.
      </p>
    </header>

    {import.meta.env.DEV && (
      <div class="roteiro">
        <p class="roteiro-tag">ESCREVA AQUI — some no build de produção</p>
        <ul class="b-lista">
          <li>Que pergunta este site responde?</li>
          <li>Para quem? (quem é o leitor que chega aqui)</li>
          <li>O que ele encontra aqui que não encontra no primeiro resultado do Google?</li>
          <li>Três links para as peças principais do site (abaixo).</li>
          <li>Mais abaixo ainda, a grade de artigos já é código de verdade — é assim que fica uma home de blog; troque os três pelos seus.</li>
        </ul>
        <p class="exemplo">
          <strong>Exemplo</strong> (apague depois de escrever o seu): "Aqui você descobre
          quanto custa mesmo trocar de operadora de internet no seu bairro — sem letra
          miúda, com os valores que as próprias operadoras cobraram de mim este mês."
        </p>
      </div>
    )}

    <section class="pecas">
      <h2 class="b-h2">Comece por aqui</h2>
      <p class="b-p">Troque os três links abaixo pelas suas três peças principais.</p>
      <div class="grade">
        <a class="b-card cartao" href="#">
          <b>Peça principal 1</b>
          <span>Troque por título e link do primeiro artigo</span>
        </a>
        <a class="b-card cartao" href="#">
          <b>Peça principal 2</b>
          <span>Troque por título e link do segundo artigo</span>
        </a>
        <a class="b-card cartao" href="#">
          <b>Peça principal 3</b>
          <span>Troque por título e link do terceiro artigo</span>
        </a>
      </div>
    </section>

    {/* Ao contrário das seções acima, esta não é roteiro: é código real, no
        build de produção, com o bloco GradeArtigos (catálogo N2) montando os
        três artigos de exemplo. Fica óbvio para quem clonou o chassi como uma
        home de blog fica depois de escrita — troque `artigosParaGrade` pelos
        seus artigos quando eles existirem. */}
    <section class="continue">
      <h2 class="b-h2">Últimos artigos</h2>
      <GradeArtigos artigos={artigosParaGrade} />
    </section>

    {/*
      ANDAIME DO CHASSI — nasce nesta seção visível (não só em comentário, e
      não só em DEV como o roteiro lá em cima) porque sem link nenhum para
      /bancada/ e /exemplo/<estilo>/ hoje só se chega ali digitando a URL, e
      as duas existem exatamente para o participante descobrir o que o
      chassi oferece antes de escrever. O aviso de "apague ao publicar" fica
      no próprio texto, visível, pela mesma razão: quem só lê o código-fonte
      no editor não vê comentário nenhum na página publicada.
    */}
    <section class="andaime">
      <p class="andaime-selo">Andaime do chassi — apague esta seção quando publicar</p>
      <h2 class="b-h2">As duas vitrines deste chassi</h2>
      <p class="b-p">
        As duas páginas abaixo não são conteúdo do seu site: são ferramenta de quem
        ainda está escrevendo o site, e não têm por que sobreviver à publicação.
      </p>
      <div class="andaime-grade">
        <a class="b-card andaime-cartao" href="/bancada/">
          <b>Bancada</b>
          <span>Responde: quais blocos existem, e qual é a regra de cada um.</span>
        </a>
        <a class="b-card andaime-cartao" href={`/exemplo/${site.estilo}/`}>
          <b>Exemplo — tema {ESTILOS[site.estilo]?.nome ?? site.estilo}</b>
          <span>Responde: como o mesmo texto fica em cada um dos cinco estilos.</span>
        </a>
      </div>
      {outrosEstilos.length > 0 && (
        <p class="andaime-outros">
          Os outros estilos, para comparar antes de escolher:{" "}
          {outrosEstilos.map((e, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/exemplo/${e}/`}>{ESTILOS[e].nome}</a>
            </>
          ))}
          .
        </p>
      )}
    </section>
  </div>
</Artigo>

<style>
  .pagina-inicial {
    max-width: var(--b-medida);
    margin-inline: auto;
    padding: 56px 20px 90px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .hero { display: flex; flex-direction: column; gap: 10px; }
  .selo {
    margin: 0;
    font-family: var(--b-fonte-meta);
    font-size: 11px;
    letter-spacing: var(--b-track-rotulo);
    text-transform: var(--b-caixa-rotulo);
    color: var(--b-tinta-2);
  }

  .roteiro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    border: 1px dashed var(--b-linha-forte);
    border-radius: var(--b-radius);
    background: var(--b-superficie);
  }
  .roteiro-tag {
    margin: 0;
    font-family: var(--b-fonte-meta);
    font-size: 11px;
    letter-spacing: var(--b-track-rotulo);
    text-transform: var(--b-caixa-rotulo);
    color: var(--b-acento-tinta);
  }
  .exemplo { margin: 0; font-size: 14px; color: var(--b-tinta-2); font-style: italic; }

  .pecas { display: flex; flex-direction: column; gap: 12px; }
  .continue { display: flex; flex-direction: column; gap: 12px; }
  .grade { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .cartao {
    display: flex; flex-direction: column; gap: 5px;
    padding: 15px 17px; text-decoration: none; color: var(--b-tinta); font-size: 14px;
  }
  .cartao span { color: var(--b-tinta-2); font-size: 12.5px; }

  /* Borda tracejada é a mesma linguagem do `.roteiro` lá em cima: sinaliza
     "isto é andaime", mesmo esta seção sobrevivendo ao build de produção
     (o roteiro não sobrevive — ver o `import.meta.env.DEV` dele). */
  .andaime {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px 20px;
    border: 1px dashed var(--b-linha-forte);
    border-radius: var(--b-radius);
    background: var(--b-superficie);
  }
  .andaime-selo {
    margin: 0;
    font-family: var(--b-fonte-meta);
    font-size: 11px;
    letter-spacing: var(--b-track-rotulo);
    text-transform: var(--b-caixa-rotulo);
    color: var(--b-acento-tinta);
  }
  .andaime-grade {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .andaime-cartao {
    display: flex; flex-direction: column; gap: 5px;
    padding: 15px 17px; text-decoration: none; color: var(--b-tinta); font-size: 14px;
  }
  .andaime-cartao span { color: var(--b-tinta-2); font-size: 12.5px; }
  .andaime-outros { margin: 0; font-size: 13px; color: var(--b-tinta-2); }
  .andaime-outros a { color: var(--b-acento-tinta); }
</style>
