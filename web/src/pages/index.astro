---
import Base from "../layouts/Base.astro";
import { ESTILOS, SITES } from "../sites";
import type { Estilo } from "../sites";
import { CATALOGO } from "../catalogo";
import "../styles/chrome.css";

const temas = Object.keys(ESTILOS) as Estilo[];
const sitesDoTema = (e: Estilo) => Object.values(SITES).filter((s) => s.estilo === e);
---

<Base
  titulo="Blocos — holding de sites de nicho"
  descricao="Catálogo de blocos, temas e o artigo de exemplo em cada um."
>
  <header class="topo">
    <div class="wrap topo-in">
      <p class="sobrancelha">holding de sites de nicho</p>
      <h1 class="titulo">Blocos</h1>
      <p class="lede">
        {CATALOGO.length} blocos no catálogo, {temas.length} temas, dois modos. O markup é o
        mesmo em todo tema: muda só o token.
      </p>
    </div>
  </header>

  <div class="wrap conteudo">
    <section>
      <h2 class="secao">Bancada</h2>
      <p class="ajuda">
        Todo bloco do catálogo com dados fictícios, e troca de tema e modo ao vivo.
      </p>
      <a href="/bancada/" class="cartao cartao--largo">
        <b>Abrir a bancada &rarr;</b>
        <span>{CATALOGO.length} blocos, cada um com a regra que ele implementa</span>
      </a>
    </section>

    <section>
      <h2 class="secao">Artigo de exemplo, por tema</h2>
      <p class="ajuda">
        O <b>mesmo</b> artigo nos cinco temas. Só o tema muda, então dá para julgar a
        diferença sem que o conteúdo mude junto.
      </p>
      <div class="grade">
        {temas.map((e) => {
          const usam = sitesDoTema(e);
          return (
            <a href={`/exemplo/${e}/`} class="cartao">
              <span class="cab">
                <span class="ponto" style={`background:${ESTILOS[e].acento}`}></span>
                <b>{ESTILOS[e].nome}</b>
              </span>
              <span class="origem">{ESTILOS[e].origem}</span>
              <span class="usa">
                {usam.length ? usam.map((s) => s.nome).join(", ") : "sem site ainda"}
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section>
      <h2 class="secao">Sites</h2>
      <p class="ajuda">
        Cada site escolhe um tema e declara quais blocos monta, em
        <code>src/sites/index.ts</code>. Bloco que o site não declara não existe na página.
      </p>
      <div class="tabela-wrap">
        <table class="tabela">
          <thead>
            <tr><th>Site</th><th>Domínio</th><th>Tema</th><th>Blocos</th><th>Muro de e-mail</th></tr>
          </thead>
          <tbody>
            {Object.values(SITES).map((s) => (
              <tr>
                <td>{s.nome}</td>
                <td>{s.dominio}</td>
                <td><a href={`/exemplo/${s.estilo}/`}>{ESTILOS[s.estilo].nome}</a></td>
                <td>{s.blocos.length} de {CATALOGO.length}</td>
                <td>{s.muroDeEmail ? "sim, nos derivados" : "não"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<style>
  .conteudo { padding: 32px 0 90px; display: flex; flex-direction: column; gap: 34px; }
  .secao { font-size: 15px; margin: 0 0 8px; letter-spacing: -.01em; }
  .ajuda { margin: 0 0 14px; color: var(--c-ink-2); font-size: 14.5px; max-width: 68ch; }
  .ajuda code {
    font-family: var(--c-mono); font-size: .88em;
    background: var(--c-bench); padding: 1px 5px; border-radius: 4px;
  }
  .grade { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .cartao {
    display: flex; flex-direction: column; gap: 6px;
    background: var(--c-paper); border: 1px solid var(--c-rule);
    border-radius: 10px; padding: 15px 18px; text-decoration: none;
    color: var(--c-ink); font-size: 13.5px;
  }
  .cartao:hover { border-color: var(--c-mark); }
  .cartao--largo { display: inline-flex; min-width: 280px; }
  .cab { display: flex; align-items: center; gap: 8px; }
  .ponto { width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18); }
  .origem { color: var(--c-ink-2); font-size: 12.5px; line-height: 1.45; }
  .usa {
    color: var(--c-dim); font-size: 11px; font-family: var(--c-mono);
    margin-top: 2px;
  }
  .cartao--largo span { color: var(--c-dim); font-size: 12.5px; }

  .tabela-wrap { overflow-x: auto; }
  .tabela {
    width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 560px;
    background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: 10px;
  }
  .tabela th, .tabela td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--c-rule); }
  .tabela thead th {
    font-family: var(--c-mono); font-size: 10.5px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--c-dim); font-weight: 600;
  }
  .tabela tbody tr:last-child td { border-bottom: 0; }
  .tabela a { color: var(--c-mark); }
</style>

<script>document.body.classList.add("bancada");</script>
