---
/**
 * A bancada: todo bloco do catálogo, com dados fictícios, em todo estilo.
 *
 * O markup de cada bloco é o mesmo em qualquer estilo — os componentes são
 * literalmente os mesmos que um site usa. Só os tokens mudam. Se um estilo
 * novo exigir markup diferente, o problema não é o estilo: é que o bloco não
 * estava bem definido.
 */
import Base from "../layouts/Base.astro";
import Blocos from "../components/Blocos.astro";
import { CATALOGO, GRUPOS, estadoDe, numeroDe } from "../catalogo";
import { ESTILOS } from "../sites";
import type { Estilo } from "../sites";
import "../styles/chrome.css";

import Abertura from "../components/blocos/Abertura.astro";
import CaixaConclusoes from "../components/blocos/CaixaConclusoes.astro";
import Sumario from "../components/blocos/Sumario.astro";
import TabelaPanorama from "../components/blocos/TabelaPanorama.astro";
import TabelaContraste from "../components/blocos/TabelaContraste.astro";
import CitacaoDestacada from "../components/blocos/CitacaoDestacada.astro";
import CitacaoFonte from "../components/blocos/CitacaoFonte.astro";
import Checklist from "../components/blocos/Checklist.astro";
import Faq from "../components/blocos/Faq.astro";
import Fechamento from "../components/blocos/Fechamento.astro";
import Figura from "../components/blocos/Figura.astro";
import DiagramaDemo from "../components/blocos/_DiagramaDemo.astro";
import Codigo from "../components/blocos/Codigo.astro";
import Aviso from "../components/blocos/Aviso.astro";
import AtomosDemo from "../components/blocos/_AtomosDemo.astro";
import ListasDemo from "../components/blocos/_ListasDemo.astro";
import BotoesDemo from "../components/blocos/_BotoesDemo.astro";
import Enquete from "../components/blocos/Enquete.astro";
import Avaliacao from "../components/blocos/Avaliacao.astro";
import Carrossel from "../components/blocos/Carrossel.astro";
import CardRedeSocial from "../components/blocos/CardRedeSocial.astro";
import Audio from "../components/blocos/Audio.astro";
import Download from "../components/blocos/Download.astro";
import Paginacao from "../components/blocos/Paginacao.astro";
import GradeArtigos from "../components/blocos/GradeArtigos.astro";
import Toast from "../components/blocos/Toast.astro";
import Overlay from "../components/blocos/Overlay.astro";
import Comentarios from "../components/blocos/Comentarios.astro";
import Autor from "../components/blocos/Autor.astro";
import Calculadora from "../components/blocos/Calculadora.astro";
import OfertaIsca from "../components/blocos/OfertaIsca.astro";
import Newsletter from "../components/blocos/Newsletter.astro";
import Compartilhar from "../components/blocos/Compartilhar.astro";
import Passos from "../components/blocos/Passos.astro";
import Verificacao from "../components/blocos/Verificacao.astro";
import Slides from "../components/blocos/Slides.astro";
import Quiz from "../components/blocos/Quiz.astro";

import * as m from "../mock/artigo";

/* A bancada monta o catálogo inteiro, em todo estilo — ela é o inventário,
 * não um site. Estilo é forma e cor (raio, borda, sombra, fonte, tinta); ele
 * não tem opinião sobre se um bloco existe. Quem decide isso é o site, na
 * lista `blocos` do arquivo em `src/sites/<slug>.ts`. `Palco` não carrega
 * mais a noção de bloco "fora de estilo" (removida em 65efbee): aqui ele só
 * recebe `estilo`/`modo`, os mesmos para os 36 blocos, nos cinco estilos.
 */
const estiloInicial: Estilo = "linho";
const modoInicial = "claro";
const palco = { estilo: estiloInicial, modo: modoInicial as "claro" };
---

<Base
  titulo="Bancada de Blocos"
  descricao="Todo bloco do catálogo, com dados fictícios, em cinco estilos e dois modos."
>
  <header class="topo">
    <div class="wrap topo-in">
      <p class="sobrancelha">design system · holding de sites de nicho</p>
      <h1 class="titulo">Bancada de Blocos</h1>
      <p class="lede">
        Cada bloco do catálogo, com dados fictícios, em cinco estilos e dois modos.
        Os componentes aqui são <b>os mesmos</b> que um site usa: muda só o token, e o
        token tem duas camadas — <code>[data-estilo]</code> carrega forma e tipografia,
        <code>[data-modo]</code> carrega cor.
      </p>
      <p class="aviso">
        <span aria-hidden="true">▲</span>
        <span><b>Todo número desta página é fictício</b> e nunca sai de <code>src/mock/</code>.
        O que é real é a forma: cada template reserva slot para o que a doutrina exige — a
        ressalva ao lado do número, a lacuna declarada, o conflito de interesse ao lado do
        nome, a data no card. Estilo que não consegue mostrar esses slots é estilo reprovado.</span>
      </p>
    </div>
  </header>

  <div class="barra">
    <div class="wrap barra-in">
      <div class="seg" role="group" aria-label="Escolher estilo">
        {Object.entries(ESTILOS).map(([chave, e]) => (
          <button type="button" data-estilo-btn={chave} aria-pressed={chave === estiloInicial}>
            <span class="ponto" style={`background:${e.acento}`}></span>
            {e.nome}
          </button>
        ))}
      </div>
      <div class="controles">
        <div class="seg" role="group" aria-label="Escolher modo">
          <button type="button" data-modo-btn="claro" aria-pressed="true">Claro</button>
          <button type="button" data-modo-btn="escuro" aria-pressed="false">Escuro</button>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap colunas">
    <nav class="indice-trilho" aria-label="Índice de blocos">
      <div class="indice-caixa">
        <h2>Blocos</h2>
        <ol>
          {GRUPOS.map((g) => (
            <>
              <li class="indice-grupo">{g.rotulo}</li>
              {CATALOGO.filter((b) => g.estados.includes(estadoDe(b.id))).map((b) => (
                <li>
                  <a href={`#b${String(b.id).toLowerCase()}`} data-indice={String(b.id)}>
                    <span class="n">{numeroDe(b.id)}</span>
                    <span>{b.nome}</span>
                  </a>
                </li>
              ))}
            </>
          ))}
        </ol>
      </div>
    </nav>

    <div style="min-width:0">
      <nav class="indice-inline" aria-label="Índice de blocos">
        <div class="indice-caixa">
          <h2>Blocos</h2>
          <ol>
            {CATALOGO.map((b) => (
              <li>
                <a href={`#b${String(b.id).toLowerCase()}`} data-indice={String(b.id)}>
                  <span class="n">{numeroDe(b.id)}</span>
                  <span>{b.nome}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>

      {/* OS ESPÉCIMES, e só eles.
          A ordem desta lista não importa mais para a página: quem ordena e
          agrupa é `Blocos.astro`, a partir de `CATALOGO` e `GRUPOS`. Ela está
          na ordem de leitura do catálogo por cortesia com quem edita o
          arquivo, não porque alguma coisa dependa disso.

          Bloco novo no catálogo sem `slot` aqui QUEBRA A BUILD, com o nome do
          slot que falta — é o conserto definitivo do defeito de 162ad1f, em
          que os blocos 23 e 24 sumiram da bancada sem sumir do catálogo e sem
          erro nenhum. */}
      <Blocos {...palco}>
        <Fragment slot="b1"><Abertura {...m.abertura} /></Fragment>
        <Fragment slot="b2"><CaixaConclusoes itens={m.conclusoes} /></Fragment>
        <Fragment slot="b3"><Sumario itens={m.sumario} /></Fragment>
        <Fragment slot="b4"><TabelaPanorama {...m.panorama} /></Fragment>
        <Fragment slot="b5"><TabelaContraste {...m.contraste} /></Fragment>
        <Fragment slot="b6"><CitacaoDestacada texto={m.destaque} /></Fragment>
        <Fragment slot="b7"><CitacaoFonte {...m.citacao} /></Fragment>
        <Fragment slot="b8">
          <Checklist rotulo="Antes de trocar qualquer equipamento" itens={m.checklist} />
        </Fragment>
        <Fragment slot="b9"><Faq itens={m.faq} /></Fragment>
        <Fragment slot="b10"><Fechamento paragrafos={m.fechamento} /></Fragment>
        <Fragment slot="b19">
          {/* os três papéis: o diagrama é código, a prova espera arquivo, a spot
              não tem fonte porque não prova nada */}
          <div style="display:flex;flex-direction:column;gap:26px">
            <Figura {...m.figuras.diagrama.figura}>
              <DiagramaDemo {...m.figuras.diagrama.dados} />
            </Figura>
            <Figura {...m.figuras.prova} />
            <Figura {...m.figuras.spot} />
          </div>
        </Fragment>
        <Fragment slot="b20">
          <div style="display:flex;flex-direction:column;gap:22px">
            {m.codigos.map((c) => <Codigo {...c} />)}
          </div>
        </Fragment>
        <Fragment slot="b21">
          <div style="display:flex;flex-direction:column;gap:14px">
            {m.avisos.map((a) => <Aviso {...a} />)}
          </div>
        </Fragment>
        <Fragment slot="b22">
          {/* as duas variantes juntas, que é o ponto: o mesmo dado no topo e no
              fim, e o palco é o único lugar onde dá para conferir de um olhar */}
          <div style="display:flex;flex-direction:column;gap:18px">
            <Autor autor={m.autor} variante="circle" />
            <Autor autor={m.autor} variante="card" />
          </div>
        </Fragment>
        <Fragment slot="b23"><Calculadora {...m.calculadora} /></Fragment>
        <Fragment slot="b24"><OfertaIsca {...m.ofertaIsca} /></Fragment>
        <Fragment slot="b25"><Newsletter site="bancada" /></Fragment>
        <Fragment slot="b11"><Enquete {...m.enquete} /></Fragment>
        <Fragment slot="b12"><Avaliacao /></Fragment>
        <Fragment slot="b13">
          <Carrossel rotulo="Como medir o pico, passo a passo" slides={m.carrossel} />
        </Fragment>
        <Fragment slot="b14"><CardRedeSocial {...m.social} /></Fragment>
        <Fragment slot="b15"><Audio duracao={m.derivados.audio.duracao} /></Fragment>
        <Fragment slot="b16"><Download {...m.derivados.mapa} muro /></Fragment>
        <Fragment slot="b17"><Download {...m.derivados.pdf} muro /></Fragment>
        <Fragment slot="b18"><Comentarios itens={m.comentarios.slice(0, 2)} /></Fragment>
        <Fragment slot="b26">
          {/* os dois estados lado a lado, forçados por `forcarNativo`: a
              bancada é o inventário, e um navegador só nunca é o desktop e o
              celular ao mesmo tempo. Sem os dois juntos, quem decide se quer
              o bloco vê só metade do que ele faz. */}
          <div style="display:flex;flex-direction:column;gap:26px">
            <div>
              <p class="b-rotulo">Com menu nativo do sistema — celular, a maioria dos navegadores</p>
              <Compartilhar {...m.compartilhar} forcarNativo={true} />
            </div>
            <div>
              <p class="b-rotulo">Sem menu nativo — a maioria dos desktops</p>
              <Compartilhar {...m.compartilhar} forcarNativo={false} />
            </div>
          </div>
        </Fragment>
        <Fragment slot="b27"><Passos itens={m.passos} /></Fragment>
        <Fragment slot="b28"><Verificacao itens={m.verificacao} /></Fragment>
        <Fragment slot="b29">
          {/* os dois tipos de slide no mesmo deck, que é o único jeito de
              conferir de um olhar que o de texto e o de imagem têm a mesma
              altura, os mesmos controles e a mesma posição escrita */}
          <Slides rotulo="Por que o pico derruba a chamada" slides={m.slides} />
        </Fragment>
        <Fragment slot="b30">
          {/* os dois modos no mesmo palco, que é o único lugar onde dá para
              comparar de um olhar o que muda entre eles: o diagnóstico não
              tem gabarito nenhum, e a prova traz o porquê e a fonte em toda
              pergunta. Estados diferentes do mesmo bloco não se conferem em
              páginas separadas. */}
          <div style="display:flex;flex-direction:column;gap:26px">
            <div>
              <p class="b-rotulo">Modo diagnóstico — peso por opção, sem resposta certa</p>
              <Quiz {...m.quizDiagnostico} />
            </div>
            <div>
              <p class="b-rotulo">Modo prova — gabarito com porquê e fonte em cada pergunta</p>
              <Quiz {...m.quizProva} />
            </div>
          </div>
        </Fragment>
        <Fragment slot="bn1">
          <Paginacao total={9} atual={2} href={(p) => `#p${p}`} />
        </Fragment>
        <Fragment slot="bn2">
          <GradeArtigos rotulo="Continue por aqui" artigos={m.irmas} />
        </Fragment>
        <Fragment slot="bn3">
          {/* `demo` é só daqui: rende o botão que dispara cada toast, para
              dar para ver entrada, permanência (sucesso some sozinho) e saída
              (erro fecha pelo X) sem simular um formulário inteiro. Em
              qualquer artigo real este componente nasce sem esse botão. */}
          <div style="display:flex;flex-direction:column;gap:11px">
            {m.toasts.map((t) => <Toast {...t} demo />)}
          </div>
        </Fragment>
        <Fragment slot="bn4">
          <p class="b-p b-p--dim" style="font-size:14px">
            O overlay não tem gatilho de entrada, tempo, rolagem ou saída do mouse.
            Ele abre por clique num controle que anuncia o destino, e fecha por três
            caminhos: o ✕, o <b>Esc</b> e o clique fora.
          </p>
          <button class="b-btn b-btn--forte" type="button" data-abre-overlay="overlay-pdf">
            Receber o PDF
          </button>
          <Overlay id="overlay-pdf" {...m.overlay} pedeEmail />
        </Fragment>
        <Fragment slot="bn5">
          <div class="demo-progresso" aria-hidden="true">
            <span class="fio"><span class="fio-preenche"></span></span>
            <span class="linha"></span><span class="linha"></span><span class="linha"></span>
          </div>
          <p class="b-p b-p--dim" style="font-size:14px;margin-top:14px">
            No artigo ela fica fixa no topo e mede o <b>&lt;article&gt;</b>, não o documento.
            Veja funcionando em <a href="/exemplo/linho/" style="color:var(--b-acento-tinta)">um artigo inteiro</a>.
          </p>
        </Fragment>
        <Fragment slot="ba1"><AtomosDemo pico={m.atomos.pico} /></Fragment>
        <Fragment slot="ba2">
          <ListasDemo
            passos={m.atomos.passos}
            conjunto={m.atomos.conjunto}
            glossario={m.atomos.glossario}
          />
        </Fragment>
        <Fragment slot="ba3"><BotoesDemo /></Fragment>
      </Blocos>
    </div>
  </div>

  <footer class="estender">
    <div class="wrap">
      <h2>Como adicionar um estilo</h2>
      <p>
        Nenhum passo toca no markup dos blocos. Se um estilo novo exigir HTML diferente,
        o problema não é o estilo: é que o bloco não estava bem definido.
      </p>
      <ol>
        <li><b>Forma e tipografia</b> em <code>[data-estilo="nome"]</code>: raio, borda, sombra, fontes. Nenhuma cor.</li>
        <li><b>Cor</b> em <code>[data-modo="claro"]</code> e <code>[data-modo="escuro"]</code>. Nenhuma medida.</li>
        <li>Crie <code>src/styles/estilos/&lt;nome&gt;.css</code> e <code>&lt;nome&gt;.ts</code> — a varredura descobre os dois sozinha, sem tocar em arquivo compartilhado.</li>
        <li>Aponte um site para ele em <code>src/sites/index.ts</code>, com os blocos que ele monta.</li>
      </ol>
      <p style="margin-top:16px">
        A separação em duas camadas existe para uma coisa: <b>escrever o modo escuro não pode
        virar um segundo estilo</b>. Cor que vaza para a camada de forma some no outro modo, e cor
        definida só dentro de um modo nunca aparece no outro.
      </p>
      <pre><code>{`/* src/styles/estilos/editorial.css */
[data-estilo="editorial"]                     { --b-radius: 0; --b-peso-titulo: 700; }
[data-estilo="editorial"][data-modo="claro"]  { --b-fundo: #fff; --b-tinta: #111; --b-acento: #b3121f; }
[data-estilo="editorial"][data-modo="escuro"] { --b-fundo: #111; --b-tinta: #fff; --b-acento: #ff5a68; }`}</code></pre>
      <p style="margin-top:24px">
        A lista de blocos é a de
        <code>.claude/skills/artigo/referencias/arquitetura-pagina.md</code>, que é a autoridade.
        <code>src/catalogo.ts</code> é a projeção dela: componente novo nasce lá, com regra e
        trava, e só depois vira código.
      </p>
    </div>
  </footer>
</Base>

<style>
  .demo-progresso { display: flex; flex-direction: column; gap: 10px; }
  .demo-progresso .fio {
    display: block; height: 3px; border-radius: 2px;
    background: color-mix(in srgb, var(--b-tinta) 8%, transparent);
  }
  .demo-progresso .fio-preenche {
    display: block; height: 100%; width: 42%; border-radius: 2px; background: var(--b-acento);
  }
  .demo-progresso .linha {
    height: 9px; border-radius: 3px; background: var(--b-tinta-2); opacity: .28;
  }
  .demo-progresso .linha:nth-child(3) { width: 88%; }
  .demo-progresso .linha:nth-child(4) { width: 64%; }
</style>

<script is:inline>
  document.body.classList.add("bancada");

  /* A bancada é o catálogo inteiro em qualquer estilo — não existe bloco
   * "fora" de um estilo, então este script só troca token (estilo/modo).
   * Quem decide se um bloco existe é o site, não a bancada. */
  const raiz = document.documentElement;
  const palcos = [...document.querySelectorAll(".palco > [data-estilo]")];
  const btnEstilo = [...document.querySelectorAll("[data-estilo-btn]")];
  const btnModo = [...document.querySelectorAll("[data-modo-btn]")];

  let estilo = "linho";
  let modo = matchMedia("(prefers-color-scheme: dark)").matches ? "escuro" : "claro";

  function aplicar() {
    for (const p of palcos) {
      p.setAttribute("data-estilo", estilo);
      p.setAttribute("data-modo", modo);
    }
    /* o overlay vive fora dos palcos por ser <dialog> em camada de topo */
    for (const d of document.querySelectorAll("dialog")) {
      d.setAttribute("data-estilo", estilo);
      d.setAttribute("data-modo", modo);
    }
    /* o mesmo controle rege o chrome, pelo data-theme que chrome.css já lê */
    raiz.setAttribute("data-theme", modo === "escuro" ? "dark" : "light");

    for (const b of btnEstilo) {
      b.setAttribute("aria-pressed", String(b.getAttribute("data-estilo-btn") === estilo));
    }
    for (const b of btnModo) {
      b.setAttribute("aria-pressed", String(b.getAttribute("data-modo-btn") === modo));
    }
  }

  btnEstilo.forEach((b) =>
    b.addEventListener("click", () => {
      estilo = b.getAttribute("data-estilo-btn");
      aplicar();
    })
  );
  btnModo.forEach((b) =>
    b.addEventListener("click", () => {
      modo = b.getAttribute("data-modo-btn");
      aplicar();
    })
  );
  aplicar();
</script>
