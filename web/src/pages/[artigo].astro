---
/**
 * A página de um artigo publicado.
 *
 * A JUNTA do chassi vive no `getStaticPaths` abaixo: hoje ele lê os três
 * artigos de exemplo de `mock/artigos.ts`, e é só isso que muda quando a
 * renderização a partir de markdown chegar (a próxima aula do workshop) — a
 * fonte troca para a coleção de markdown, os `params` continuam sendo
 * `{ artigo: <slug> }`, e a ROTA NÃO MUDA. Quem editar este arquivo depois
 * para ligar o markdown deve trocar só a função abaixo, nunca o caminho do
 * arquivo nem a forma da URL.
 *
 * Os slugs são deliberadamente mock (`artigo-1`, `artigo-2`, `artigo-3`) e a
 * URL fica na raiz (`/artigo-1/`), porque é essa a forma que o artigo de
 * verdade vai ter quando existir.
 *
 * A composição do corpo é dirigida por dados: cada artigo em `mock/artigos.ts`
 * é uma lista de SLOTS, e este arquivo só sabe desenhar cada tipo de slot —
 * quem decide a ordem e quais blocos aparecem é o mock, artigo por artigo.
 * É por isso que os três artigos podem montar um repertório de blocos
 * diferente sem este arquivo crescer um `if` por artigo.
 *
 * Os blocos usados aqui são exatamente os que `sites/exemplo.ts` declara em
 * `TODOS_DE_ARTIGO` (1 a 10, 19 a 22, 26, A1, A2, A3) mais a navegação que o
 * site escolheu em `NAVEGACAO_DE_ARTIGO` (N2 e N5, com o porquê de cada um
 * dos cinco comentado lá) — bloco fora da lista do site não é montado nesta
 * página, pela mesma regra que vale para qualquer site do chassi. Por isso
 * os dois blocos de navegação abaixo checam `site.blocos.includes(...)`
 * antes de montar, em vez de nascerem incondicionais.
 */
import Artigo from "../layouts/Artigo.astro";
import { siteInstitucional } from "../institucional/dados";
import { ARTIGOS, autor } from "../mock/artigos";
import type { DadosArtigo, Slot } from "../mock/artigos";
import { dataBR } from "../data";

import CabecalhoArtigo from "../components/CabecalhoArtigo.astro";
import Titulo from "../components/Titulo.astro";
import Sumario from "../components/blocos/Sumario.astro";
import Abertura from "../components/blocos/Abertura.astro";
import CaixaConclusoes from "../components/blocos/CaixaConclusoes.astro";
import TabelaPanorama from "../components/blocos/TabelaPanorama.astro";
import TabelaContraste from "../components/blocos/TabelaContraste.astro";
import Figura from "../components/blocos/Figura.astro";
import CitacaoDestacada from "../components/blocos/CitacaoDestacada.astro";
import CitacaoFonte from "../components/blocos/CitacaoFonte.astro";
import Codigo from "../components/blocos/Codigo.astro";
import Aviso from "../components/blocos/Aviso.astro";
import Checklist from "../components/blocos/Checklist.astro";
import Faq from "../components/blocos/Faq.astro";
import Fechamento from "../components/blocos/Fechamento.astro";
import AutorBloco from "../components/blocos/Autor.astro";
import Compartilhar from "../components/blocos/Compartilhar.astro";
import BarraProgresso from "../components/blocos/BarraProgresso.astro";
import GradeArtigos from "../components/blocos/GradeArtigos.astro";
import type { Artigo as ItemDeGrade } from "../components/blocos/GradeArtigos.astro";

export function getStaticPaths() {
  return ARTIGOS.map((artigo) => ({
    params: { artigo: artigo.slug },
    props: { artigo },
  }));
}

const { artigo } = Astro.props as { artigo: DadosArtigo };
const site = siteInstitucional();

/* N2 — as irmãs deste artigo, no mesmo formato que a home (`index.astro`)
   já usa para a grade. "Continue por aqui" só faz sentido com quem NÃO é o
   artigo que o leitor já está lendo. */
const irmas: ItemDeGrade[] = ARTIGOS.filter((a) => a.slug !== artigo.slug).map((a) => ({
  tituloFeed: a.titulo,
  descricao: a.descricao,
  atualizadoEm: dataBR(a.atualizado),
  href: `/${a.slug}/`,
}));

/* O sumário é derivado dos slots do tipo "titulo", nunca digitado à parte —
   mesma regra de `mock/lorem.ts`, aqui aplicada a três roteiros diferentes. */
const ehTitulo = (s: Slot): s is Extract<Slot, { tipo: "titulo" }> => s.tipo === "titulo";
const sumario = artigo.slots.filter(ehTitulo).map((s) => ({
  texto: s.texto,
  href: `#${s.id}`,
  nivel: s.nivel,
}));

/* O mesmo gate de nascimento de Sumario.astro (menos de 4 H2 e ele não
   nasce), replicado aqui só para decidir se a coluna do trilho existe no
   grid abaixo. Divergir deste número do de lá não quebra nada — o sintoma
   seria uma coluna vazia no desktop, nunca um sumário fantasma. */
const h2DoSumario = sumario.filter((s) => (s.nivel ?? 2) === 2).length;
const temSumario = h2DoSumario >= 4;

/* Bloco 26 (Compartilhar) pede URL absoluta e canônica — `site.dominio` mais
   o mesmo slug que vira a rota desta página (ver `getStaticPaths` acima). */
const urlDoArtigo = `https://${site.dominio}/${artigo.slug}/`;
---

<Artigo site={site} titulo={`${artigo.titulo} — ${site.nome}`} descricao={artigo.descricao}>
  <div class="colunas">
    <article class="artigo b-regua-lados">
      {/* N5 — mede este <article>, nunca o documento inteiro. É por isso que
          o "continue por aqui" (N2, abaixo) fica DEPOIS de fechar esta tag:
          a regra do bloco é literal — "barra que fica em 70% quando o que
          sobra é rodapé e grade de cards mente sobre quanto falta" — e uma
          grade de cards é exatamente o que o N2 é. Não dispara nada: só
          informa. */}
      {site.blocos.includes("N5") && <BarraProgresso alvo="article.artigo" />}

      <CabecalhoArtigo
        selo={artigo.selo}
        titulo={artigo.titulo}
        atualizado={artigo.atualizado}
        minutos={artigo.minutos}
        autor={autor}
      />

      <Abertura {...artigo.abertura} />

      {artigo.conclusoes && (
        <CaixaConclusoes rotulo={artigo.conclusoes.rotulo} itens={artigo.conclusoes.itens} />
      )}

      {/* UM sumário só no HTML — nunca dois. No celular este bloco é só mais
          um item da coluna, no fluxo, antes do corpo: "inline no celular",
          como o catálogo exige. A partir de 1180px o CSS abaixo transforma
          este mesmo elemento na segunda coluna do grid (`.corpo-grade`) e
          `trilho` (em Sumario.astro) liga o sticky que o mantém visível
          durante a rolagem — sem desenhar uma segunda nav em lugar nenhum. */}
      <div class:list={["corpo-grade", { "com-sumario": temSumario }]}>
        <Sumario itens={sumario} trilho />

        <div class="corpo">
          {artigo.slots.map((s) => (
            <>
              {s.tipo === "titulo" && <Titulo nivel={s.nivel} id={s.id}>{s.texto}</Titulo>}
              {s.tipo === "paragrafo" && <p class="b-p">{s.texto}</p>}
              {s.tipo === "prosa" && <p class="b-p" set:html={s.html} />}
              {s.tipo === "lista" && (
                <ol class="b-lista-num">{s.itens.map((item) => <li>{item}</li>)}</ol>
              )}
              {s.tipo === "tabelaPanorama" && (
                <TabelaPanorama colunas={s.colunas} linhas={s.linhas} fonte={s.fonte} />
              )}
              {s.tipo === "tabelaContraste" && (
                <TabelaContraste colunas={s.colunas} linhas={s.linhas} fonte={s.fonte} />
              )}
              {s.tipo === "figura" && <Figura {...s.dados} />}
              {s.tipo === "citacaoDestacada" && <CitacaoDestacada texto={s.texto} />}
              {s.tipo === "citacaoFonte" && (
                <CitacaoFonte texto={s.texto} nome={s.nome} papel={s.papel} conflito={s.conflito} />
              )}
              {s.tipo === "codigo" && <Codigo {...s.dados} />}
              {s.tipo === "aviso" && <Aviso {...s.dados} />}
              {s.tipo === "checklist" && <Checklist rotulo={s.rotulo} itens={s.itens} />}
              {s.tipo === "faq" && <Faq itens={s.itens} />}
              {s.tipo === "fechamento" && <Fechamento paragrafos={s.paragrafos} />}
            </>
          ))}

          <AutorBloco autor={autor} variante="card" />

          {/* 26, depois do card do autor: o último ato de quem terminou de
              ler, não conteúdo do corpo — por isso vem fora do map de slots,
              igual ao Autor logo acima. */}
          <Compartilhar url={urlDoArtigo} texto={artigo.titulo} />
        </div>
      </div>
    </article>

    {/* N2, DE PROPÓSITO fora de <article>: é chrome de navegação, não corpo
        do artigo (ver `catalogo.ts`, estado "navegacao"), e ficar fora é o
        que garante que a barra de progresso acima — que mede exatamente
        "article.artigo" — nunca conte esta grade como se fosse leitura. */}
    {site.blocos.includes("N2") && (
      <section class="fecho b-regua-topo b-esquinas-topo" aria-label="Continue por aqui">
        <GradeArtigos rotulo="Continue por aqui" artigos={irmas} />
      </section>
    )}
  </div>
</Artigo>

<style>
  .colunas {
    display: grid;
    justify-content: center;
    max-width: 892px;
    margin-inline: auto;
    padding: 0 clamp(18px, 4vw, 28px);
  }

  /* A moldura mora aqui, colada na coluna de leitura — mesma decisão de
     `/exemplo/[estilo]`, documentada lá: é essa largura que dá às réguas
     (verticais, sangria) um lugar próprio para desenhar. */
  .artigo {
    --b-sangria: clamp(28px, 4.5vw, 40px);
    max-width: 836px;
    min-width: 0;
    padding: clamp(24px, 5vw, 56px) var(--b-sangria) 80px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  /* N2, fora de <article> (ver o comentário no template): sem o padding de
     `.artigo` ao redor para herdar, repete aqui só a largura da coluna de
     leitura e a mesma sangria, para a régua/cruz do topo (que desenha na
     largura do PRÓPRIO elemento) fechar exatamente onde o texto fechava.
     `justify-self: start` é explícito porque, ao contrário de `.artigo`, este
     item não é o único filho de `.colunas` — sem isto o alinhamento de um
     item mais estreito que o irmão ficaria a critério do navegador. */
  .fecho {
    --b-sangria: clamp(28px, 4.5vw, 40px);
    max-width: 836px;
    justify-self: start;
    padding: 30px var(--b-sangria) 0;
  }

  /* No celular o sumário é só mais um item desta coluna, no fluxo — o mínimo
     que o bloco 3 exige. `.corpo` repete o mesmo gap de `.artigo`: para o
     leitor a costura entre os dois é invisível, é só um wrapper para o
     desktop conseguir tratar "sumário" e "corpo" como as duas colunas do
     grid abaixo. */
  .corpo-grade { display: flex; flex-direction: column; gap: 26px; }
  .corpo { display: flex; flex-direction: column; gap: 26px; }

  /* O extra do bloco 3: o trilho fixo do desktop, a partir de 1180px — mesmo
     ponto de corte do `@media` em Sumario.astro, que decide o que acontece
     DENTRO da coluna (sticky, altura, rolagem). Aqui só se abre a coluna: o
     grid nasce apenas quando o sumário nasceu de verdade (`.com-sumario`),
     senão o artigo continua de uma coluna só e não sobra gutter vazio.
     `order` deixa a nav primeiro no DOM (cumprindo "antes do corpo" no
     celular) e ainda assim desenhada à direita no desktop. */
  @media (min-width: 1180px) {
    .colunas { max-width: 1164px; }
    .artigo { max-width: 1108px; }

    .corpo-grade.com-sumario {
      display: grid;
      grid-template-columns: minmax(0, 836px) 232px;
      column-gap: 40px;
      align-items: start;
    }
    .corpo-grade.com-sumario > .corpo { order: 1; }
    .corpo-grade.com-sumario > :global(nav.sumario) { order: 2; }
  }
</style>
