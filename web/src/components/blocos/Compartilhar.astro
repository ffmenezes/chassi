---
/** Bloco 26 — Compartilhar.
 *
 * WhatsApp primeiro, porque o público é brasileiro. Os outros destinos vêm
 * depois, na mesma lista.
 *
 * ZERO script de terceiro. Nenhum SDK do Facebook, do X ou botão oficial de
 * rede nenhuma — são rastreadores, e a doutrina deste repositório proíbe JS de
 * terceiro sem justificativa (ver `infra.md`). Compartilhar é montar uma URL:
 * cada destino aqui é um `<a href>` comum, com a mensagem já codificada na
 * query string, sem biblioteca nenhuma.
 *
 * `navigator.share()` é o caminho do celular — entrega o menu nativo do
 * sistema, que já inclui WhatsApp e qualquer outro app instalado — e por isso
 * ele SOMA à lista abaixo, nunca a substitui. Já existiu versão deste bloco
 * que escondia os cinco destinos quando `navigator.share` existia — errado
 * por dois motivos, e os dois valem registrar aqui para ninguém desfazer o
 * conserto: o menu nativo é opaco (o leitor não sabe o que vai encontrar lá
 * dentro antes de clicar, enquanto cinco destinos nomeados dizem exatamente
 * o que o site oferece) e `navigator.share` é reportado por navegadores de
 * DESKTOP também, onde o menu do sistema costuma ser pior que um link direto
 * para o WhatsApp. Trocar informação explícita por um botão surpresa era
 * perda, não simplificação.
 *
 * Onde o nativo existe, ele costuma ser o melhor caminho — por isso vem
 * PRIMEIRO no HTML, com a lista abaixo como alternativa explícita. Ele nasce
 * `hidden` e o script no fim do arquivo só tira o `hidden`; nunca esconde a
 * lista.
 *
 * Melhoria progressiva, sem exceção: a lista de links nasce visível no HTML,
 * funciona clicada sem JS nenhum, e o script deste arquivo só ACRESCENTA o
 * nativo por cima dela. Sem JS, ou em navegador sem a API, a lista continua
 * ali sozinha, cada item um link de verdade.
 *
 * "Copiar link" reusa `ligarCopia()` (de `../../copiarLink`), o mesmo botão
 * do cabeçalho e do título de seção: mesmo ouvinte delegado, mesmo aviso a
 * leitor de tela, e o mesmo comportamento sem `navigator.clipboard` — o botão
 * aparece e não faz nada ao clicar, e o leitor ainda tem os outros destinos.
 */
export interface Props {
  /** URL absoluta e canônica do que está sendo compartilhado. */
  url: string;
  /** Frase curta que acompanha o link — o título do artigo, ou um gancho de uma linha. */
  texto: string;
  /** Só o inventário usa isto: força o estado do botão nativo sem depender da
   *  capacidade real do navegador que abriu a página. Existe porque o
   *  inventário é o lugar onde o dono decide se quer o bloco — e ali um único
   *  navegador só mostra metade da verdade: quem
   *  abre no desktop nunca vê o estado "com nativo", quem abre no celular
   *  nunca vê o estado "sem nativo" sozinho. `true` força visível, `false`
   *  força oculto. Ausente — o único caminho em produção, e o padrão — o
   *  bloco detecta `navigator.share` em runtime, exatamente como sempre. */
  forcarNativo?: boolean;
}
const { url, texto, forcarNativo } = Astro.props;

const urlCodificada = encodeURIComponent(url);
const textoCodificado = encodeURIComponent(texto);
const mensagemCodificada = encodeURIComponent(`${texto} ${url}`);

/* WhatsApp primeiro, sempre — o resto entra na ordem em que faz sentido para
   o público brasileiro: o que roda em app instalado, depois o que só abre
   página web, e o e-mail por último, por ser o destino mais formal. */
const DESTINOS = [
  { nome: "WhatsApp", href: `https://wa.me/?text=${mensagemCodificada}` },
  { nome: "Telegram", href: `https://t.me/share/url?url=${urlCodificada}&text=${textoCodificado}` },
  { nome: "X", href: `https://twitter.com/intent/tweet?text=${textoCodificado}&url=${urlCodificada}` },
  { nome: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${urlCodificada}` },
  { nome: "E-mail", href: `mailto:?subject=${textoCodificado}&body=${mensagemCodificada}` },
] as const;
---

<div
  class="compartilhar"
  data-compartilhar
  data-url={url}
  data-texto={texto}
  data-forcar-nativo={forcarNativo === undefined ? undefined : String(forcarNativo)}
>
  <p class="b-rotulo">Compartilhar</p>

  {/* Primeiro no HTML, escondido por padrão: em produção (`forcarNativo`
      ausente) só aparece quando o script confirma `navigator.share`. No
      inventário, `forcarNativo` decide o `hidden` aqui mesmo, sem depender do
      navegador que abriu a página. É o botão que entrega o menu nativo do
      sistema — SOMA à lista abaixo, nunca a substitui (ver o porquê no topo
      do arquivo). */}
  <button type="button" class="dest nativo" data-compartilhar-nativo hidden={forcarNativo !== true}>
    Compartilhar
  </button>

  <ul class="destinos" data-destinos>
    {DESTINOS.map((d) => (
      <li>
        <a class="dest" href={d.href} target="_blank" rel="noopener noreferrer">{d.nome}</a>
      </li>
    ))}
    <li>
      <button
        type="button"
        class="dest copia"
        data-copia
        data-copia-antes="Copiar link"
        data-copia-depois="Copiado"
      >
        <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M240,88.23a54.43,54.43,0,0,1-16,37L189.25,160a54.27,54.27,0,0,1-38.63,16h-.05A54.63,54.63,0,0,1,96,119.84a8,8,0,0,1,16,.45A38.62,38.62,0,0,0,150.58,160h0a38.39,38.39,0,0,0,27.31-11.31l34.75-34.75a38.63,38.63,0,0,0-54.63-54.63l-11,11A8,8,0,0,1,135.7,59l11-11A54.65,54.65,0,0,1,224,48,54.86,54.86,0,0,1,240,88.23ZM109,185.66l-11,11A38.41,38.41,0,0,1,70.6,208h0a38.63,38.63,0,0,1-27.29-65.94L78,107.31A38.63,38.63,0,0,1,144,135.71a8,8,0,0,0,16,.45A54.86,54.86,0,0,0,144,96a54.65,54.65,0,0,0-77.27,0L32,130.75A54.62,54.62,0,0,0,70.56,224h0a54.28,54.28,0,0,0,38.64-16l11-11A8,8,0,0,0,109,185.66Z"></path>
        </svg>
        <span data-copia-rotulo>Copiar link</span>
      </button>
    </li>
  </ul>
</div>

<style>
  .compartilhar { max-width: var(--b-medida); }

  .destinos, .destinos li { list-style: none; margin: 0; padding: 0; }
  .destinos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }

  .dest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--b-radius);
    border: var(--b-borda);
    background: var(--b-superficie);
    color: var(--b-tinta);
    font-family: var(--b-fonte-meta);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: border-color .15s, color .15s;
  }
  /* `:not(.nativo)` é o conserto: sem ele, esta regra também pega o botão
     nativo logo abaixo — que compartilha a classe `.dest` só para herdar
     tamanho de toque e cursor — e troca o TEXTO dele para `--b-acento-tinta`
     por cima de um fundo que já É `--b-acento`. Os dois tokens nascem do
     mesmo acento, então o texto quase desaparece no próprio fundo: é o
     "zero contraste" relatado, e acontece nos dez pares estilo×modo porque
     a regra é do seletor, não de token de estilo nenhum. */
  .dest:not(.nativo):hover,
  .dest[data-copiado] { border-color: var(--b-acento-tinta); color: var(--b-acento-tinta); }
  .dest svg { width: 14px; height: 14px; }

  .nativo {
    /* `margin-bottom` só conta quando o botão está visível — `hidden` tira o
       elemento do fluxo, então isto não move nada no caso comum (a maioria
       dos desktops), e abre o respiro certo quando ele soma à lista abaixo. */
    margin: 0 0 10px;
    padding: 10px 18px;
    border-radius: var(--b-radius);
    border: 0;
    background: var(--b-acento);
    color: var(--b-sobre-acento);
    font-family: var(--b-fonte-meta);
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s;
  }
  /* Mesma receita de `.b-btn--forte` em `atomos.css`: botão preenchido troca
     de INTENSIDADE no hover, não de par texto/fundo. `--b-sobre-acento` já
     foi escolhido para ler bem sobre `--b-acento`, e `--b-acento-forte` é o
     mesmo acento mais forte — a leitura continua garantida sem token novo. */
  .nativo:hover { background: var(--b-acento-forte); }

  /* Foco por teclado do nativo tem o mesmo problema de raiz do hover: o anel
     nasce `outline: 2px solid currentColor` (contrato, `base.css`) e aqui
     `currentColor` é `--b-sobre-acento` — a cor pensada para ler sobre
     `--b-acento` (o preenchimento do botão), não sobre `--b-fundo` (a tela
     por trás, onde o anel de fato cai, por causa do `outline-offset`). Nos
     dois modos de quase todo estilo, sobre-acento e fundo são o mesmo
     extremo (branco no claro, quase preto no escuro): o anel some. Troca só
     a cor do anel, para o mesmo `--b-acento-tinta` que os destinos já usam
     no hover — testado contra `--b-fundo` nos dez pares. */
  .nativo:focus-visible { outline-color: var(--b-acento-tinta); }
</style>

<script>
  import { ligarCopia } from "../../copiarLink";
  ligarCopia();

  /* `navigator.share` é o único jeito de saber se o sistema tem menu nativo,
     e só existe descobrindo em runtime — daí o `<script>`, com a mesma régua
     de melhoria progressiva do resto do catálogo: a lista de links já
     funciona sozinha, isto só ACRESCENTA o botão nativo por cima dela quando
     há algo melhor. Nunca esconde `[data-destinos]` — essa era a versão
     antiga, e o porquê de ela estar errada está no comentário do topo do
     arquivo. */
  for (const raiz of document.querySelectorAll<HTMLElement>("[data-compartilhar]")) {
    const nativo = raiz.querySelector<HTMLButtonElement>("[data-compartilhar-nativo]");
    if (!nativo) continue;

    /* `data-forcar-nativo` só existe no inventário: quando presente, o `hidden`
       já foi decidido no servidor (ver o Props do componente) e este script
       não deve sobrepor a escolha com a capacidade real do navegador que
       está rodando o espécime. */
    const forcado = raiz.dataset.forcarNativo !== undefined;
    if (!forcado && "share" in navigator) nativo.hidden = false;

    if ("share" in navigator) {
      nativo.addEventListener("click", () => {
        const dados = { title: raiz.dataset.texto, url: raiz.dataset.url };
        /* Recusa do leitor (fechou o menu) ou API indisponível no momento: os
           dois caem aqui, e não há o que fazer além de não quebrar a página —
           o botão continua onde estava, pronto para um novo clique. */
        navigator.share(dados).catch(() => {});
      });
    }
  }
</script>
