---
/** Bloco 20 — Bloco de código.
 *
 * O trecho literal que o leitor copia ou digita. O custo do erro aqui é dele:
 * comando errado colado num terminal não devolve o estado anterior. Daí as duas
 * travas que quebram a build em vez de virarem revisão manual.
 *
 * Sem realce de sintaxe: crawler de IA não executa JS (`infra.md`), e realce no
 * cliente entrega bloco cru para quem indexa e ainda paga em peso. Havendo
 * realce um dia, ele é gerado na build.
 *
 * O botão de copiar é a trava do `$` deixando de ser teoria: sem botão, colar
 * "$ npm install" só quebra o comando de quem digitou à mão, devagar, e
 * provavelmente já tirou o cifrão no processo. Com um botão que copia a
 * string exata, o cifrão vai colado — é a diferença entre um comando que roda
 * e um que o terminal rejeita, e é isso que faz a regra valer a pena de
 * verdade, não só em revisão de PR.
 *
 * O botão NÃO guarda o código num atributo (`data-copia-texto`, tentado e
 * revertido): isso dobrava o peso deste bloco no HTML, que é exatamente o que
 * `infra.md` proíbe pagar sem necessidade. `data-copia-alvo="code"` aponta o
 * `<code>` logo abaixo, e `ligarCopia()` lê o `textContent` dele NO CLIQUE —
 * o mesmo texto limpo que já está na página, sem segunda cópia. Um realce de
 * sintaxe futuro (comentário abaixo) não muda nada aqui: `textContent` de um
 * elemento com `<span>` dentro devolve o texto sem as tags do mesmo jeito.
 *
 * JS de cliente, com justificativa: `ligarCopia()` (de `../../copiarLink`) é
 * melhoria progressiva pura — sem JS, ou sem `navigator.clipboard`, o botão
 * não aparece (a prop é `false`) ou aparece e não faz nada ao clicar, e o
 * código continua ali, selecionável à mão, exatamente como antes de existir
 * o botão.
 */
export interface Props {
  /** Onde isso é colado: `bash`, `.env`, "fórmula da planilha", "display do inversor". */
  rotulo: string;
  /** Literal e reproduzível. Trecho "arrumado" é paráfrase em monoespaçada. */
  codigo: string;
  /** Obrigatório quando o trecho altera estado: o que ele faz e o que não desfaz. */
  aviso?: string;
  /**
   * Botão de copiar, opcional por prop. Ligado por padrão: é melhoria pura
   * (ver comentário acima), então desligá-la por padrão privaria a maioria
   * dos blocos de uma vantagem sem custo algum. Um bloco pensado só para
   * leitura — nunca para colar — passa `copiar={false}`.
   */
  copiar?: boolean;
}
const { rotulo, codigo, aviso, copiar = true } = Astro.props;

const erro = (m: string) => {
  throw new Error(`[bloco 20] ${m}`);
};

if (!rotulo.trim()) {
  erro(`bloco de código sem rótulo. O leitor precisa saber onde aquilo é colado antes de colar.`);
}

const linhas = codigo.trim().split("\n");
const comCifrao = linhas.find((l) => /^\s*[$#>]\s/.test(l));
if (comCifrao) {
  erro(
    `linha começando com prompt (${comCifrao.trim().slice(0, 24)}…). O cifrão viaja ` +
      `junto na cópia e quebra o comando. Precisando separar comando de saída, ` +
      `são dois blocos, cada um com o seu rótulo.`
  );
}

const texto = linhas.join("\n");
---

<div class="codigo" data-copia-bloco>
  <div class="cab">
    <p class="b-rotulo rot">{rotulo}</p>
    {copiar && (
      <button
        type="button"
        class="copia"
        data-copia
        data-copia-alvo="code"
        data-copia-antes="Copiar"
        data-copia-depois="Copiado"
        data-copia-anuncio="Código copiado."
        aria-label={`Copiar o código de ${rotulo}`}
      >
        <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32Zm-8,128H176V88a8,8,0,0,0-8-8H96V48H208Z"></path>
        </svg>
        <span data-copia-rotulo aria-hidden="true">Copiar</span>
      </button>
    )}
  </div>
  {aviso && <p class="alerta">{aviso}</p>}
  <div class="rolagem"><pre><code>{texto}</code></pre></div>
</div>

<style>
  .codigo { max-width: var(--b-medida); }
  .rot { margin-bottom: 7px; }

  .cab {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 7px;
  }
  .cab .rot { margin-bottom: 0; }

  /* Mesma linguagem visual do botão de copiar do cabeçalho do artigo e do
     título de seção (`CabecalhoArtigo.astro`, `Titulo.astro`): texto + ícone,
     sem fundo nem borda, muda de cor no hover e enquanto `data-copiado`
     está presente. Não é `.b-btn`: aquele é peso de ação de tela (bloco A3),
     este é uma utilidade discreta ao lado do rótulo — mesmo papel visual nos
     três lugares onde "copiar" existe no chassi. */
  .copia {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    font-family: var(--b-fonte-meta);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--b-track-rotulo);
    text-transform: var(--b-caixa-rotulo);
    color: var(--b-tinta-2);
    cursor: pointer;
    transition: color .15s;
  }
  .copia:hover,
  .copia[data-copiado] { color: var(--b-acento-tinta); }
  .copia svg { width: 13px; height: 13px; }

  /* o que o comando faz e o que ele não desfaz vem ANTES, em texto: é a
     ressalva do número, na camada em que o leitor executa */
  .alerta {
    font-family: var(--b-fonte-meta);
    font-size: 12px;
    line-height: 1.5;
    color: var(--b-tinta-2);
    margin: 0 0 8px;
    padding-left: 10px;
    border-left: 2px solid var(--b-acento);
  }

  /* rola dentro do próprio container: o corpo da página nunca rola de lado */
  .rolagem {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--b-superficie);
    border: var(--b-borda);
    border-radius: var(--b-radius);
    box-shadow: var(--b-sombra);
  }
  pre {
    margin: 0;
    padding: 14px 16px;
    /* comando não quebra linha sozinho: quebra invisível é comando errado colado */
    white-space: pre;
  }
  code {
    font-family: var(--b-fonte-codigo);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--b-corpo);
    tab-size: 2;
  }
</style>

{/* Sem condicionar ao `copiar`: `ligarCopia()` é idempotente (documentado em
    `copiarLink.ts`) e, com `copiar={false}`, este bloco não tem nenhum
    `[data-copia]` para o ouvinte delegado encontrar — chamar de qualquer jeito
    é mais simples e mais seguro do que arriscar um `<script>` dentro de um
    bloco condicional do template. */}
<script>
  import { ligarCopia } from "../../copiarLink";
  ligarCopia();
</script>
