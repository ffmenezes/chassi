---
/** Bloco 11 — Enquete.
 * Pergunta e opções no HTML inicial; só o contador pode ser JS.
 * Voto não fica atrás de e-mail. O `piso` de respostas se define ANTES de
 * abrir a enquete: definir depois de ver o número é escolher o piso que faz
 * o argumento fechar.
 *
 * O radio nasce nativo e funciona sem JS — só não lembra o voto entre uma
 * visita e outra sem ele. O script no fim deste arquivo guarda a escolha em
 * `localStorage` e marca de novo ao recarregar; bloco interativo sem
 * interação é decoração, e escolher sem que nada aconteça era exatamente
 * essa decoração.
 *
 * A honestidade do texto importa tanto quanto a do piso: "voto guardado
 * neste navegador" é o que de fato acontece hoje. "Voto registrado" seria
 * mentira enquanto não existir quem registre — e é por isso que o aviso
 * abaixo nunca usa essa palavra.
 *
 * "Voltar atrás": ao contrário da Avaliação, aqui não existe via de mão
 * única para decidir — nenhum radio fica desabilitado depois de escolhido,
 * então trocar de opção é só clicar em outra, o gesto nativo de sempre. Não
 * há tela de "obrigado" que substitui a pergunta; a pergunta continua ali,
 * editável, sempre. Por isso este bloco não ganhou controle extra de reset.
 *
 * Também declara o contrato em `api/contrato.ts` (`CAMINHOS.enquete`), por
 * trás de uma guarda: só tenta mandar o voto adiante quando a página conhece
 * `site` e `slug` — nas vitrines (bancada, exemplo), nada sai daqui além do
 * `localStorage`. A porta de dados está inerte (adaptador `nenhum`); quando
 * ela acordar, é publicar a Function no caminho certo — este componente já
 * está pronto e não muda.
 *
 * `especime`: modo vitrine, no espírito do `demo` do Toast — mas aqui a
 * troca não é "mostrar um botão a mais", é "não guardar nada". Ligado, o
 * radio continua respondendo a clique normalmente, só que sem tocar
 * `localStorage`: nada é lido na entrada nem escrito na saída, e cada
 * recarga da bancada volta ao estado inicial (nenhuma opção marcada) — que é
 * exatamente o estado que se precisa ver para julgar o bloco. Ausente (o
 * caso de qualquer artigo real), nada muda.
 */
import { CAMINHOS, urlDaApi } from "../../api/contrato";

interface Props {
  pergunta: string;
  opcoes: string[];
  piso: number;
  nome?: string;
  /** Do post que hospeda o bloco. Sem os dois, o envio ao backend não é
   *  tentado — só o `localStorage` funciona (é o caso da bancada e do
   *  exemplo). */
  site?: string;
  slug?: string;
  /** Modo vitrine: o bloco funciona, mas não lê nem escreve `localStorage`.
   *  Só a bancada liga isto. */
  especime?: boolean;
}
const { pergunta, opcoes, piso, nome = "enquete", site, slug, especime = false } = Astro.props;
const endpoint = urlDaApi(CAMINHOS.enquete);
---
<form
  class="b-card enquete"
  data-enquete={nome}
  data-endpoint={endpoint}
  data-site={site}
  data-slug={slug}
  data-especime={especime ? "true" : undefined}
>
  <p class="b-rotulo">Enquete</p>
  <p class="pergunta"><b>{pergunta}</b></p>
  <div class="opcoes">
    {opcoes.map((o, i) => (
      <label>
        <input type="radio" name={nome} value={String(i)} />
        <span>{o}</span>
      </label>
    ))}
  </div>
  <p class="n">
    Resultado publicado só acima de {piso} respostas. Piso definido antes de abrir a enquete.
  </p>
  <p class="n status" data-status aria-live="polite" hidden>
    Voto guardado neste navegador. Ainda não há apuração.
  </p>
</form>
<script is:inline>
  /* Aplica o voto guardado ANTES da primeira pintura, para não piscar sem
   * opção marcada e só depois marcar a certa. Um `<script>` comum do Astro
   * sai como módulo adiado (`defer` implícito de `type="module"`), então
   * corre depois que o HTML já foi pintado — é exatamente esse intervalo
   * que pisca. Este script é `is:inline` (o Astro não o toca nem o move) e
   * roda síncrono, no ponto exato em que aparece: bloqueia o parser aqui
   * mesmo, antes de haver qualquer oportunidade de pintura para o restante
   * da página. Por isso fica mínimo, sem `template literal` (concatenação
   * com `+`, como o resto do repo) e sem nada que não seja "ler o guardado
   * e marcar o radio certo". A leitura completa, com o manipulador de
   * troca, é o script de baixo. */
  (function () {
    var form = document.currentScript.previousElementSibling;
    if (!form || form.dataset.especime === "true") return;
    var chave = "enquete:" + location.pathname + ":" + form.dataset.enquete;
    var salvo = "";
    try {
      salvo = localStorage.getItem(chave) || "";
    } catch (erro) {}
    if (!salvo) return;
    var radios = form.querySelectorAll('input[type="radio"]');
    for (var i = 0; i < radios.length; i++) {
      if (radios[i].value === salvo) {
        radios[i].checked = true;
        break;
      }
    }
    var status = form.querySelector("[data-status]");
    if (status) status.hidden = false;
  })();
</script>
<style>
  .enquete { padding: 20px 22px; }
  .pergunta { margin: 0; color: var(--b-tinta); }
  .opcoes { display: flex; flex-direction: column; gap: 9px; margin: 14px 0 0; }
  label {
    display: flex; align-items: center; gap: 11px; padding: 11px 14px;
    border: var(--b-borda); border-radius: var(--b-radius); cursor: pointer;
    color: var(--b-corpo);
  }
  label:hover { border-color: var(--b-acento); }
  input { accent-color: var(--b-acento); }
  .n { margin: 12px 0 0; font-family: var(--b-fonte-meta); font-size: 11.5px; color: var(--b-tinta-2); }
  .status { margin-top: 6px; }
</style>

<script>
  /* Melhoria progressiva: sem JS, os radios continuam funcionando — a
     pessoa vota, só que a escolha não sobrevive a um F5 e o aviso de
     "guardado neste navegador" nunca aparece (com razão: sem JS, nada foi
     guardado além do que o próprio navegador guarda em campo de formulário
     comum, ou seja, nada entre visitas). */
  for (const form of document.querySelectorAll<HTMLFormElement>(".enquete[data-enquete]")) {
    const especime = form.dataset.especime === "true";
    const chave = "enquete:" + location.pathname + ":" + form.dataset.enquete;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const radios = [...form.querySelectorAll<HTMLInputElement>('input[type="radio"]')];

    /* O script `is:inline` acima já marcou o radio certo antes da pintura;
       aqui só cobre o caso (raro) de este script rodar sem aquele ter
       encontrado o elemento anterior — ler de novo é inofensivo. */
    if (!especime) {
      let salvo = "";
      try {
        salvo = localStorage.getItem(chave) ?? "";
      } catch {}
      if (salvo) {
        const escolhido = radios.find((r) => r.value === salvo);
        if (escolhido) {
          escolhido.checked = true;
          status.hidden = false;
        }
      }
    }

    form.addEventListener("change", (ev) => {
      const alvo = ev.target as HTMLInputElement;
      if (alvo.type !== "radio") return;

      if (!especime) {
        try {
          localStorage.setItem(chave, alvo.value);
        } catch {}
      }
      status.hidden = false;

      /* Guarda: sem `site`/`slug` não tenta nada além do que já aconteceu
         acima. Com os dois, é melhor esforço — a interface já mostrou o
         voto guardado antes de qualquer requisição sair, então falha de
         rede ou 404 (a Function ainda não existe) não muda nada na tela. */
      const site = form.dataset.site;
      const slug = form.dataset.slug;
      const endpoint = form.dataset.endpoint;
      if (!especime && site && slug && endpoint) {
        fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          keepalive: true,
          body: JSON.stringify({
            site,
            slug,
            enquete: form.dataset.enquete,
            opcao: Number(alvo.value),
          }),
        }).catch(() => {});
      }
    });
  }
</script>
