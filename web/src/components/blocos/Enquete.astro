---
/** Bloco 11 — Enquete (previsto).
 * Pergunta e opções no HTML inicial; só o contador pode ser JS.
 * Voto não fica atrás de e-mail. O `piso` de respostas se define ANTES de
 * abrir a enquete: definir depois de ver o número é escolher o piso que faz
 * o argumento fechar. */
interface Props { pergunta: string; opcoes: string[]; piso: number; nome?: string }
const { pergunta, opcoes, piso, nome = "enquete" } = Astro.props;
---
<form class="b-card enquete">
  <p class="b-rotulo">Enquete</p>
  <p class="pergunta"><b>{pergunta}</b></p>
  <div class="opcoes">
    {opcoes.map((o, i) => (
      <label>
        <input type="radio" name={nome} value={String(i)} />
        <span>{o}</span>
      </label>
    ))}
  </div>
  <p class="n">
    Resultado publicado só acima de {piso} respostas. Piso definido antes de abrir a enquete.
  </p>
</form>
<style>
  .enquete { padding: 20px 22px; }
  .pergunta { margin: 0; color: var(--b-tinta); }
  .opcoes { display: flex; flex-direction: column; gap: 9px; margin: 14px 0 0; }
  label {
    display: flex; align-items: center; gap: 11px; padding: 11px 14px;
    border: var(--b-borda); border-radius: var(--b-radius); cursor: pointer;
    color: var(--b-corpo);
  }
  label:hover { border-color: var(--b-acento); }
  input { accent-color: var(--b-acento); }
  .n { margin: 12px 0 0; font-family: var(--b-fonte-meta); font-size: 11.5px; color: var(--b-tinta-2); }
</style>
