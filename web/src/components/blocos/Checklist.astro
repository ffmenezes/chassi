---
/** Bloco 8 — Checklist.
 * Recapitula, nunca introduz: todo item tem uma seção que o sustenta.
 *
 * A caixa era `disabled` de propósito enquanto não houvesse estado guardado
 * — caixa que esquece o clique ao recarregar é promessa quebrada. Agora ela
 * guarda em `localStorage` deste navegador e recarrega marcada: a promessa
 * se cumpre, e a caixa nasce nativa, funcionando sem JS (só não lembra sem
 * ele). Bloco interativo sem interação é decoração, e é essa decoração que
 * o script no fim deste arquivo substitui por comportamento real.
 *
 * "Voltar atrás": ao contrário da Avaliação, aqui não existe via de mão
 * única — cada caixa continua sendo um checkbox nativo, e desmarcar é só
 * clicar de novo nela. Não há tela final que substitui a lista; a lista
 * inteira continua editável, item a item, para sempre. Por isso este bloco
 * não ganhou controle extra de reset.
 *
 * Também declara o contrato em `api/contrato.ts` (`CAMINHOS.checklist`), por
 * trás de uma guarda: só tenta mandar o clique adiante quando a página
 * conhece `site` e `slug` — nas duas vitrines (inventário e exemplo), que não
 * têm nenhum dos dois, nada sai daqui além do `localStorage`. A porta de
 * dados está inerte (adaptador `nenhum`); quando ela acordar, é publicar a
 * Function no caminho certo — este componente já está pronto e não muda.
 *
 * `especime`: modo vitrine, no espírito do `demo` do Toast — mas aqui a
 * troca não é "mostrar um botão a mais", é "não guardar nada". Ligado, cada
 * caixa continua marcando e desmarcando normalmente, só que sem tocar
 * `localStorage`: nada é lido na entrada nem escrito na saída, e cada
 * recarga do inventário volta ao estado inicial (nada marcado) — que é
 * exatamente o estado que se precisa ver para julgar o bloco. Ausente (o
 * caso de qualquer artigo real), nada muda.
 */
import { CAMINHOS, urlDaApi } from "../../api/contrato";

export interface ItemCheck { forte: string; resto: string }
interface Props {
  rotulo?: string;
  itens: ItemCheck[];
  teto?: number;
  /** Identifica este checklist quando a página tem mais de um. Sem ele, o
   *  rótulo faz esse papel; sem rótulo, todo checklist da página é "único". */
  id?: string;
  /** Do post que hospeda o bloco. Sem os dois, o envio ao backend não é
   *  tentado — só o `localStorage` funciona (é o caso do inventário e do
   *  exemplo). */
  site?: string;
  slug?: string;
  /** Modo vitrine: o bloco funciona, mas não lê nem escreve `localStorage`.
   *  Só o inventário liga isto. */
  especime?: boolean;
}
const { rotulo, itens, teto = 7, id, site, slug, especime = false } = Astro.props;
const lista = itens.slice(0, teto);
const idChecklist = id ?? rotulo ?? "unico";
const endpoint = urlDaApi(CAMINHOS.checklist);
---
<div
  class="checklist"
  data-checklist={idChecklist}
  data-endpoint={endpoint}
  data-site={site}
  data-slug={slug}
  data-especime={especime ? "true" : undefined}
>
  {rotulo && <p class="b-rotulo">{rotulo}</p>}
  <ul>
    {lista.map((i, idx) => (
      <li>
        <input type="checkbox" data-idx={idx} />
        <span><b>{i.forte}</b> {i.resto}</span>
      </li>
    ))}
  </ul>
</div>
<script is:inline>
  /* Aplica as caixas guardadas ANTES da primeira pintura, para não piscar
   * tudo desmarcado e só depois marcar as certas. Um `<script>` comum do
   * Astro sai como módulo adiado (`defer` implícito de `type="module"`),
   * então corre depois que o HTML já foi pintado — é exatamente esse
   * intervalo que pisca. Este script é `is:inline` (o Astro não o toca nem
   * o move) e roda síncrono, no ponto exato em que aparece: bloqueia o
   * parser aqui mesmo, antes de haver qualquer oportunidade de pintura para
   * o restante da página. Por isso fica mínimo, sem `template literal`
   * (concatenação com `+`, como o resto do repo) e sem nada que não seja
   * "ler o guardado e marcar as caixas certas". A leitura completa, com o
   * manipulador de clique, é o script de baixo. */
  (function () {
    var bloco = document.currentScript.previousElementSibling;
    if (!bloco || bloco.dataset.especime === "true") return;
    var chave = "checklist:" + location.pathname + ":" + bloco.dataset.checklist;
    var marcados = [];
    try {
      marcados = JSON.parse(localStorage.getItem(chave) || "[]");
    } catch (erro) {}
    if (!marcados.length) return;
    var itens = bloco.querySelectorAll("input[type=checkbox]");
    for (var i = 0; i < itens.length; i++) {
      var idx = Number(itens[i].dataset.idx);
      if (marcados.indexOf(idx) !== -1) itens[i].checked = true;
    }
  })();
</script>
<style>
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  li { display: grid; grid-template-columns: auto 1fr; gap: 11px; align-items: start; color: var(--b-corpo); }
  b { color: var(--b-tinta); }
  input { margin-top: 4px; width: 16px; height: 16px; accent-color: var(--b-acento); }
</style>

<script>
  /* Melhoria progressiva: sem JS, cada caixa é um checkbox comum e marca
     normalmente — só não sobrevive a um F5. O que o JS acrescenta é só a
     lembrança, guardada por página e por checklist (`location.pathname` +
     `data-checklist`), nunca por site inteiro, para o mesmo checklist em
     dois posts não se misturar. */
  for (const caixa of document.querySelectorAll<HTMLElement>(".checklist[data-checklist]")) {
    const especime = caixa.dataset.especime === "true";
    const chave = "checklist:" + location.pathname + ":" + caixa.dataset.checklist;
    const itens = [...caixa.querySelectorAll<HTMLInputElement>("input[type=checkbox]")];

    let marcados: number[] = [];
    if (!especime) {
      /* O script `is:inline` acima já marcou as caixas certas antes da
         pintura; aqui só cobre o caso (raro) de este script rodar sem
         aquele ter encontrado o elemento anterior — ler de novo é
         inofensivo. */
      try {
        marcados = JSON.parse(localStorage.getItem(chave) ?? "[]");
      } catch {}
      for (const item of itens) {
        const idx = Number(item.dataset.idx);
        if (marcados.includes(idx)) item.checked = true;
      }
    }

    caixa.addEventListener("change", (ev) => {
      const alvo = ev.target as HTMLInputElement;
      if (alvo.type !== "checkbox") return;
      const idx = Number(alvo.dataset.idx);

      const atuais = new Set(marcados);
      if (alvo.checked) atuais.add(idx); else atuais.delete(idx);
      marcados = [...atuais];
      if (!especime) {
        try {
          localStorage.setItem(chave, JSON.stringify(marcados));
        } catch {}
      }

      /* Guarda: sem `site`/`slug` (inventário, exemplo) não tenta nada além do
         localStorage acima, que já é a fonte da verdade. Com os dois, é
         melhor esforço — falha de rede ou 404 (a Function ainda não existe)
         não muda nada na tela, porque a tela já refletia o clique antes de
         qualquer requisição sair. */
      const site = caixa.dataset.site;
      const slug = caixa.dataset.slug;
      const endpoint = caixa.dataset.endpoint;
      if (!especime && site && slug && endpoint) {
        fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          keepalive: true,
          body: JSON.stringify({
            site,
            slug,
            checklist: caixa.dataset.checklist,
            item: idx,
            marcado: alvo.checked,
          }),
        }).catch(() => {});
      }
    });
  }
</script>
