---
/**
 * H2 e H3 do artigo, com o elo que o leitor copia.
 *
 * Existe como componente por dois motivos, e nenhum deles é economia de digitação:
 *
 *   1. O elo tem que estar no HTML inicial. `<a href="#id">` sem script ainda
 *      leva à seção — copiar é o upgrade, não o mecanismo. A alternativa comum
 *      (injetar a âncora por JS depois do load, que é o que a Cloudflare faz)
 *      entrega ao crawler um heading sem elo nenhum.
 *   2. O `id` e o elo nascem do MESMO lugar. Digitados em separado, divergem na
 *      primeira edição, e o sintoma é o clique que não faz nada — exatamente o
 *      defeito contra o qual o `Sumario` já avisa em console.
 *
 * O ícone é do Phosphor Icons (MIT).
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h2"> {
  /** 2 é a seção; 3 é a subseção. Não existe nível 4: ver a regra do bloco 3. */
  nivel?: 2 | 3;
  /** O mesmo id que o sumário aponta. É daqui que sai o `href` do elo. */
  id: string;
}
const { nivel = 2, id, class: classe, ...resto } = Astro.props;
const Tag = nivel === 3 ? "h3" : "h2";
---

<Tag class:list={[nivel === 3 ? "b-h3" : "b-h2", classe]} id={id} {...resto}>
  <a
    class="b-ancora"
    href={`#${id}`}
    aria-label="Copiar link para esta seção"
    data-copia
    data-copia-antes="Copiar link"
    data-copia-depois="Copiado"
  >
    <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
      <path d="M240,88.23a54.43,54.43,0,0,1-16,37L189.25,160a54.27,54.27,0,0,1-38.63,16h-.05A54.63,54.63,0,0,1,96,119.84a8,8,0,0,1,16,.45A38.62,38.62,0,0,0,150.58,160h0a38.39,38.39,0,0,0,27.31-11.31l34.75-34.75a38.63,38.63,0,0,0-54.63-54.63l-11,11A8,8,0,0,1,135.7,59l11-11A54.65,54.65,0,0,1,224,48,54.86,54.86,0,0,1,240,88.23ZM109,185.66l-11,11A38.41,38.41,0,0,1,70.6,208h0a38.63,38.63,0,0,1-27.29-65.94L78,107.31A38.63,38.63,0,0,1,144,135.71a8,8,0,0,0,16,.45A54.86,54.86,0,0,0,144,96a54.65,54.65,0,0,0-77.27,0L32,130.75A54.62,54.62,0,0,0,70.56,224h0a54.28,54.28,0,0,0,38.64-16l11-11A8,8,0,0,0,109,185.66Z"></path>
    </svg>
    <span class="b-ancora-dica" data-copia-rotulo aria-hidden="true">Copiar link</span>
  </a><slot />
</Tag>

<script>
  import { ligarCopia } from "../copiarLink";
  ligarCopia();
</script>
