---
/**
 * O formulário de contato: `method="post"` comum, sem fetch, na mesma porta
 * que `web/functions/api/contato.ts` atende — `urlDaApi(CAMINHOS.contato)`,
 * nunca `/api/contato` escrito na mão, porque quem atende pode virar Worker
 * amanhã sem que este componente mude.
 *
 * O widget do Turnstile só entra na página quando existe chave pública. Sem
 * ela o formulário continua funcionando — `manejarContato` recusa com 403
 * quando a verificação falhar, então um formulário sem Turnstile ainda
 * envia, só que sem anti-spam. Widget que tenta montar sem chave é tela
 * quebrada para o leitor, o que é pior que ficar sem anti-spam por um tempo.
 * Mesmo padrão que `Comentarios.astro` já usa.
 *
 * A validação no cliente (script no fim do arquivo) NUNCA substitui a de
 * `functions/_lib/contato.ts`: o servidor recusa de novo tudo o que passar
 * por aqui, porque cliente pode estar com JS desligado, com extensão
 * bloqueando, ou falando direto com a API sem passar por formulário nenhum.
 * O que o cliente compra é só a distância entre errar e saber — sem ele, um
 * e-mail malformado só falha depois do POST, numa resposta de texto puro.
 * Bloco interativo sem interação é decoração: um formulário que só descobre
 * o próprio erro no servidor é essa mesma decoração, só que mais lenta.
 *
 * O sucesso não ganha toast aqui: o envio de verdade é navegação nativa
 * (sem fetch, de propósito), e o servidor já redireciona para
 * `/contato-recebido/` — uma confirmação visível de verdade, e não um toast
 * que a própria troca de página nem deixaria o leitor ver. Fingir um
 * "enviado!" antes de o servidor confirmar seria a mesma mentira que
 * `manejarContato` já recusa a contar ("não finge que enviou").
 */
import { CAMINHOS, urlDaApi } from "../api/contrato";
import type { Site } from "../sites/tipos";
import Toast from "./blocos/Toast.astro";

interface Props { site: Site }
const { site } = Astro.props;

const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
---

<form class="formulario-contato" method="post" action={urlDaApi(CAMINHOS.contato)} data-form-contato>
  <input type="hidden" name="site" value={site.slug} />

  <div class="campo-bloco">
    <label class="rotulo" for="fc-nome">Seu nome</label>
    <input class="campo" id="fc-nome" name="nome" type="text" maxlength="120" required />
  </div>

  <div class="campo-bloco">
    <label class="rotulo" for="fc-email">Seu e-mail</label>
    <input class="campo" id="fc-email" name="email" type="email" maxlength="254" required />
  </div>

  <div class="campo-bloco">
    <label class="rotulo" for="fc-mensagem">Sua mensagem</label>
    <textarea class="campo" id="fc-mensagem" name="mensagem" rows="5" maxlength="5000" required></textarea>
  </div>

  {sitekey ? (
    <div class="cf-turnstile" data-sitekey={sitekey}></div>
  ) : (
    /* Só em build de desenvolvimento: em produção sem chave, o formulário
       fica sem esta faixa, mudo sobre o motivo, porque avisar o leitor final
       que "isto não tem anti-spam" não é informação dele. */
    import.meta.env.DEV && (
      <p class="aviso-dev">
        PUBLIC_TURNSTILE_SITEKEY não está definida: este formulário envia sem
        verificação humana.
      </p>
    )
  )}

  <button class="botao" type="submit">Enviar mensagem</button>
</form>

<Toast id="fc-toast-erro" tipo="erro" titulo="Não deu para enviar" texto="Confira os campos destacados." hidden />

{sitekey && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<style>
  .formulario-contato {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: var(--b-medida);
  }
  .campo-bloco { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .rotulo {
    font-family: var(--b-fonte-meta);
    font-size: 11px;
    letter-spacing: var(--b-track-rotulo);
    text-transform: var(--b-caixa-rotulo);
    color: var(--b-tinta-2);
  }
  .campo {
    width: 100%;
    padding: 11px 13px;
    font-size: 15px;
    line-height: 1.55;
    border: var(--b-borda);
    border-radius: var(--b-radius);
    background: var(--b-fundo);
    color: var(--b-tinta);
    resize: vertical;
    font-family: inherit;
  }
  .campo:invalid { border-color: var(--b-erro); }
  .aviso-dev {
    margin: 0;
    padding: 10px 12px;
    font-size: 13px;
    color: var(--b-tinta-2);
    background: var(--b-superficie);
    border: var(--b-borda);
    border-radius: var(--b-radius);
  }
  .botao {
    align-self: flex-start;
    padding: 11px 22px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--b-sobre-acento);
    background: var(--b-acento);
    border: 0;
    border-radius: var(--b-radius);
    cursor: pointer;
  }
  .botao:hover { background: var(--b-acento-forte); }
</style>

<script>
  /* Melhoria progressiva: `required`/`type="email"` no HTML são o piso —
     sem JS, é o navegador que barra campo vazio e e-mail malformado, com a
     bolha nativa dele. Só quando este script roda é que `noValidate` desliga
     essa bolha, para o toast abaixo assumir o aviso (mesma regra, feedback
     melhor). Se o script não rodar, a validação nativa continua de pé. */
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const form = document.querySelector<HTMLFormElement>("[data-form-contato]");
  const toastErro = document.getElementById("fc-toast-erro");
  if (form) form.noValidate = true;

  function mostrarErro(texto: string) {
    if (!toastErro) return;
    const msg = toastErro.querySelector<HTMLElement>(".txt");
    if (msg) msg.textContent = texto;
    toastErro.hidden = false;
  }

  form?.addEventListener("submit", (ev) => {
    const nome = form.querySelector<HTMLInputElement>("#fc-nome")!;
    const email = form.querySelector<HTMLInputElement>("#fc-email")!;
    const mensagem = form.querySelector<HTMLTextAreaElement>("#fc-mensagem")!;

    if (!nome.value.trim() || !email.value.trim() || !mensagem.value.trim()) {
      ev.preventDefault();
      mostrarErro("Preencha nome, e-mail e mensagem.");
      return;
    }
    /* Mesmo regex de `functions/_lib/contato.ts`. Não dá para importar o
       módulo da Function aqui (fica fora do bundle do cliente por design —
       ver CLAUDE.md), então a regra é copiada, não compartilhada: mudou lá,
       muda aqui também. */
    if (!EMAIL.test(email.value.trim())) {
      ev.preventDefault();
      mostrarErro("E-mail inválido.");
    }
  });
</script>
