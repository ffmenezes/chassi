---
/** Casca mínima. Só o que toda página precisa. */
import "../styles/base.css";
import "../styles/estilos/index";
import "../styles/atomos.css";
import Analytics from "../components/Analytics.astro";
import BarraAviso from "../components/BarraAviso.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import Consentimento from "../components/Consentimento.astro";
import type { Site } from "../sites/tipos";
import { LANG_HTML } from "../idioma";
import { tagsSociais } from "../social/tags";

interface Props {
  titulo: string;
  descricao?: string;
  lang?: string;
  /** Página de serviço, que existe para quem já está no site e não para busca. */
  noindex?: boolean;
  /** Ausente na bancada, de propósito: espécime não é site, e não mede nada. */
  site?: Site;
  /** Artigo ou pagina. Decide o og:type. */
  tipo?: "website" | "article";
  /** Caminho do card desta pagina. O padrao serve as institucionais. */
  imagemCard?: string;
  /**
   * O título do card, SEM a marca. O `<title>` leva a marca de propósito —
   * é o que serve a aba do navegador e o resultado de busca —, mas `og:title`
   * não: `og:site_name` já diz a marca, e o PNG do card desenha o título cru.
   * Um valor, duas renderizações. Padrão: o próprio `titulo`.
   */
  tituloSocial?: string;
}
const {
  titulo, descricao, lang = LANG_HTML, noindex = false, site,
  tipo = "website", imagemCard = "/social/padrao.png", tituloSocial = titulo,
} = Astro.props;

/* A DECISÃO — se esta página se anuncia, e com o quê — mora em
   `social/tags.ts`, onde um teste consegue fixá-la. Aqui só se mapeia dado
   para elemento. */
const social = tagsSociais({
  site, caminho: Astro.url.pathname, titulo: tituloSocial,
  descricao, noindex, tipo, imagemCard,
});

/* `encodeURIComponent` porque o emoji agora é do participante, e não mais uma
   constante nossa: `#️⃣` começa com `#`, que dentro de um data URI abre
   fragmento e engole o resto do SVG — a aba ficaria sem ícone nenhum, sem
   erro nenhum, e ninguém descobriria por quê. */
const iconeEmoji = (e: string) =>
  `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>` +
  `<text y='14' font-size='14'>${encodeURIComponent(e)}</text></svg>`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      A ordem das camadas é decidida AQUI, antes de qualquer folha entrar.

      Camada é ordenada por primeira aparição, e em desenvolvimento o Vite
      injeta as folhas depois do HTML da página — então declarar a ordem só
      dentro de base.css fazia `site` aparecer primeiro e PERDER, com o sintoma
      clássico: "mexi no token do site e nada mudou".

      `is:inline` para o Astro não processar nem mover este bloco.
    */}
    <style is:inline>@layer contrato, estilo, modo, site;</style>
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {social.map((t) =>
      t.tag === "link" ? (
        <link rel={t.rel} href={t.href} />
      ) : t.atributo === "property" ? (
        <meta property={t.nome} content={t.conteudo} />
      ) : (
        <meta name={t.nome} content={t.conteudo} />
      ),
    )}
    {site?.icone && (
      <link rel="icon" href={iconeEmoji(site.icone)} />
    )}
    {!site && <link rel="icon" href={iconeEmoji("🧱")} />}
    {site && <Analytics site={site} />}
  </head>
  <body>
    {/*
      O gate é `site` truthy, o mesmo que já decidia se `<Analytics>` entra.
      Bancada e vitrine de estilo não passam `site` pra `Base` — de propósito,
      ver o comentário de `Cabecalho.astro` — e por isso nascem sem chrome de
      navegação nenhum.

      `<BarraAviso>` vem ANTES do `<Cabecalho>`, de propósito: ela é
      `position: sticky` e nasce no topo do documento, então precisa ser o
      primeiro elemento do `<body>` pra grudar ali. Ela mesma decide se
      renderiza algo (gate em `site.avisoBarra`), então isto é inofensivo
      quando nenhum site declara o campo.
    */}
    {site && <BarraAviso site={site} />}
    {site && <Cabecalho site={site} />}
    <slot />
    {site && (
      <>
        <Rodape site={site} />
        <Consentimento site={site} />
      </>
    )}
  </body>
</html>
