{
  "name": "@chassi/web",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "dev:restart": "astro dev --force",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "preview": "astro preview --port 4399",
    "check": "astro check",
    "test": "vitest run",
    "check:functions": "tsc -p functions --noEmit",
    "tunel": "cloudflared tunnel --url http://localhost:4321 --no-autoupdate",
    "inventario": "astro build && node scripts/inline.mjs inventario > ../inventario.html"
  },
  "dependencies": {
    "astro": "^7.2.2",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
