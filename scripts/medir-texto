#!/usr/bin/env bash
# Legibilidade e SEO on-page de um post.md. O código está em
# _lib/medir-texto.py; aqui só se acha o Python do sistema (ver _lib/python).
#
# Uso: scripts/medir-texto sites/<slug>/posts/<peça>/post.md ["query-alvo"]
exec bash "$(dirname "$0")/_lib/python" "$(dirname "$0")/_lib/medir-texto.py" "$@"
